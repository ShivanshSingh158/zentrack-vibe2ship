{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@domains/*": ["src/domains/*"],
      "@agent/*": ["src/agent/*"],
      "@services/*": ["src/services/*"],
      "@state/*": ["src/state/*"],
      "@navigation/*": ["src/navigation/*"]
    }
  }
}
