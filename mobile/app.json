{
  "expo": {
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "name": "ZenTrack",
    "slug": "mobile",
    "owner": "shiv_2",
    "scheme": "zentrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_white.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo_white.png",
      "resizeMode": "contain",
      "backgroundColor": "#060509"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "ZenTrack uses speech recognition for voice-to-text input.",
        "NSMicrophoneUsageDescription": "ZenTrack needs microphone access for S.A.R.A voice commands."
      }
    },
    "android": {
      "package": "com.shiv157.zentrack",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#060509",
        "foregroundImage": "./assets/logo_white.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "ZenTrack needs microphone access for S.A.R.A voice commands."
        }
      ],
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "application/pdf"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ZenTrack needs microphone access for S.A.R.A voice commands.",
          "speechRecognitionPermission": "ZenTrack uses speech recognition for voice-to-text input.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "./plugins/withAndroidManifestMod.js",
      "@react-native-community/datetimepicker",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.336719988763-a8l7noum7dapki5st6uoqvscnnlkid7e"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZenTrack needs access to your photos to let you set a profile picture or log progress photos."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayAgenda",
              "label": "ZenTrack Today",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "minResizeWidth": "180dp",
              "minResizeHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "600dp",
              "resizeMode": "horizontal|vertical",
              "description": "Today's schedule, live classes, attendance and tasks",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LiveWorkout",
              "label": "ZenTrack Workout HUD",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "minResizeWidth": "180dp",
              "minResizeHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "600dp",
              "resizeMode": "horizontal|vertical",
              "description": "Live active gym set logger and routine tracker",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo_white.png",
          "color": "#a599ff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e09ae680-52ee-4e7f-85cf-4446c556d005"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e09ae680-52ee-4e7f-85cf-4446c556d005"
    }
  }
}
